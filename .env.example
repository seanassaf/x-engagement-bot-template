# Copy this file to `.env` and fill in your own values. `.env` is gitignored.

# ── Shared X API credentials (OAuth 1.0a — read-only is enough) ──
# From your X developer app → Keys and tokens → "OAuth 1.0 Keys".
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=

# ── LLM (reply generation; OpenAI-compatible or Anthropic endpoint) ──
LLM_API_KEY=
LLM_MODEL=
# For Anthropic, set the base URL (client auto-detects anthropic.com). The /v1 is required:
# LLM_BASE_URL=https://api.anthropic.com/v1
# For OpenAI / OpenAI-compatible:
# LLM_BASE_URL=https://api.openai.com/v1

# ── Account browser login ──
# Shared rules: twitter-guerilla/base-persona.md
# Account voice:  twitter-guerilla/personas/<account-key>.md
# Variables are loaded by convention: X_USER_<KEY> / X_PASS_<KEY> where <KEY> is the
# uppercased account key. The default account key is `myaccount` (env key MYACCOUNT):
X_USER_MYACCOUNT=
X_PASS_MYACCOUNT=
# Optional: email/phone identifier if X challenges the login
# X_LOGIN_IDENTIFIER_MYACCOUNT=
# Optional: force manual interactive login when seeding a profile locally (run headed)
# X_LOGIN_MANUAL_MYACCOUNT=1

# ── Optional global overrides ──
# ENGAGEMENT_CONTEXT=
# CHROME_PATH=

# ── Optional scheduler controls (used by railway:scheduler) ──
# SESSION_SCHEDULER_TIMEZONE=America/New_York
# SESSION_SCHEDULER_START_HOUR=9
# SESSION_SCHEDULER_END_HOUR=18
# SESSION_SCHEDULER_WEEKDAYS=1,2,3,4,5
# SESSION_SCHEDULER_MIN_PER_DAY=1
# SESSION_SCHEDULER_MAX_PER_DAY=5
# SESSION_SCHEDULER_MIN_GAP_MINUTES=60
# SESSION_SCHEDULER_SLOT_MINUTES=5
# SESSION_SCHEDULER_SESSION_ARGS=session myaccount --buyer-intent-random
