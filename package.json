{
  "name": "marketing",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@10.15.0",
  "bin": {
    "marketing": "./marketing.ts"
  },
  "scripts": {
    "test": "node --test test/twitter-guerilla/*.test.ts",
    "marketing": "node ./marketing.ts",
    "dev": "pnpm --dir gif-generator dev",
    "editor": "pnpm --dir gif-generator editor",
    "generate-gif": "pnpm --dir gif-generator generate-gif",
    "x-engage": "node ./marketing.ts engage",
    "x-cookies:export": "node ./twitter-guerilla/export-x-cookies.ts --account myaccount",
    "x-session": "node ./marketing.ts session",
    "x-session:myaccount": "node ./marketing.ts session myaccount",
    "x-session:fresh": "node ./marketing.ts session --fresh-session",
    "x-session:fresh:myaccount": "node ./marketing.ts session myaccount --fresh-session",
    "x-session-all": "node ./marketing.ts session all",
    "x-session-all:fresh": "node ./marketing.ts session all --fresh-session",
    "railway:scheduler": "node ./twitter-guerilla/railway-scheduler.ts",
    "railway:scheduler:dry-run": "node ./twitter-guerilla/railway-scheduler.ts --dry-run",
    "railway:run-now": "node ./twitter-guerilla/railway-scheduler.ts --force-run",
    "railway:run-now:dry-run": "node ./twitter-guerilla/railway-scheduler.ts --force-run --dry-run",
    "railway:seed-x-cookies": "node ./twitter-guerilla/seed-x-cookies.ts --account myaccount",
    "railway:buyer-intent-random": "node ./marketing.ts session myaccount --buyer-intent-random",
    "railway:buyer-intent-dry-run": "node ./marketing.ts session myaccount --buyer-intent-random --dry-run"
  },
  "dependencies": {
    "puppeteer-core": "^24.40.0"
  }
}
